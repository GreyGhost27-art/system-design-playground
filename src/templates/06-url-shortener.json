{
  "id": "url-shortener",
  "title": "URL shortener",
  "summary": "Load balancing, caching, a key-value store and async analytics together.",
  "lesson": {
    "problem": "Build a service that turns long URLs into short codes and redirects millions of clicks a day.",
    "why": [
      "Redirects vastly outnumber new links (often 100:1), so the read path is what matters. Hot links are served from the cache; the rest come from a key-value store that maps code → URL.",
      "Short codes come from an ID generator: a counter encoded in base62 gives short, unique codes with no collisions to check.",
      "Counting clicks must not slow down redirects, so each click is published to a queue and an analytics worker aggregates them later."
    ],
    "takeaways": [
      "Design for the dominant path: here, fast cached reads.",
      "A simple key-value access pattern fits a NoSQL store that scales horizontally.",
      "Use 302 redirects if you need to count every click; 301s are cached by browsers."
    ]
  },
